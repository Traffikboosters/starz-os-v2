<script>
// Dark mode toggle
function toggleDarkMode() {
  document.documentElement.classList.toggle('dark');
  document.getElementById('darkModeToggle').classList.toggle('active');
  localStorage.setItem('starz-dark-mode', document.documentElement.classList.contains('dark'));
}

// Load dark mode preference
if (localStorage.getItem('starz-dark-mode') === 'true') {
  document.documentElement.classList.add('dark');
  document.getElementById('darkModeToggle').classList.add('active');
}

// Generate starfield in dark mode
function generateStars() {
  const container = document.getElementById('starfield');
  container.innerHTML = '';
  for (let i = 0; i < 50; i++) {
    const star = document.createElement('div');
    star.className = 'star';
    star.style.left = Math.random() * 100 + '%';
    star.style.top = Math.random() * 100 + '%';
    star.style.animationDelay = Math.random() * 3 + 's';
    star.style.opacity = Math.random() * 0.5 + 0.2;
    container.appendChild(star);
  }
}
generateStars();

// Workspace switching
function showWorkspace(workspace) {
  document.querySelectorAll('.workspace-view').forEach(w => w.classList.remove('active'));
  document.getElementById('workspace-' + workspace).classList.add('active');

  document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
  const activeNav = document.querySelector('[data-workspace="' + workspace + '"]');
  if (activeNav) activeNav.classList.add('active');

  const titles = {
    'dashboard': 'Executive Operations Dashboard',
    'crm': 'CRM Workspace',
    'powerdial': 'PowerDial',
    'deals': 'Deals Pipeline',
    'workorders': 'Work Orders',
    'ai-engines': 'AI Engines',
    'marketing': 'Marketing',
    'fulfillment': 'Fulfillment Workspace',
    'contractor': 'BGE Contractor Portal',
    'partner': 'Partner Client Portal',
    'recruiting': 'HR / Recruiting'
  };
  document.getElementById('pageTitle').textContent = titles[workspace] || 'STARZ-OS';

  closeMobileSidebar();

  // Re-animate score bars
  setTimeout(() => {
    document.querySelectorAll('.workspace-view.active .score-bar-fill').forEach(bar => {
      const width = bar.style.width;
      bar.style.width = '0%';
      setTimeout(() => { bar.style.width = width; }, 50);
    });
  }, 100);
}

// Role switching
function setRole(role) {
  document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('role-' + role).classList.add('active');

  const navItems = document.querySelectorAll('[data-nav]');
  navItems.forEach(item => {
    const nav = item.getAttribute('data-nav');
    if (role === 'sales') {
      if (['dashboard','crm','powerdial','deals','ai-engines','contractor'].includes(nav)) {
        item.style.display = 'flex';
      } else if (['workorders','fulfillment','recruiting','partner'].includes(nav)) {
        item.style.display = 'none';
      } else {
        item.style.display = 'flex';
      }
    } else if (role === 'fulfillment') {
      if (['workorders','fulfillment','marketing','reports','ai-engines'].includes(nav)) {
        item.style.display = 'flex';
      } else if (['crm','powerdial','deals','contractor'].includes(nav)) {
        item.style.display = 'none';
      } else {
        item.style.display = 'flex';
      }
    } else {
      item.style.display = 'flex';
    }
  });
}

// Mobile sidebar
function openMobileSidebar() {
  document.getElementById('mobileOverlay').classList.add('open');
  const sidebar = document.getElementById('sidebarDesktop');
  sidebar.style.position = 'fixed';
  sidebar.style.left = '0';
  sidebar.style.top = '0';
  sidebar.style.bottom = '0';
  sidebar.style.zIndex = '50';
  sidebar.style.display = 'flex';
  sidebar.classList.add('sidebar-mobile');
}

function closeMobileSidebar() {
  document.getElementById('mobileOverlay').classList.remove('open');
  const sidebar = document.getElementById('sidebarDesktop');
  if (window.innerWidth > 1024) {
    sidebar.style.position = '';
    sidebar.style.left = '';
    sidebar.style.top = '';
    sidebar.style.bottom = '';
    sidebar.style.zIndex = '';
    sidebar.style.display = '';
    sidebar.classList.remove('sidebar-mobile');
  } else {
    sidebar.style.display = 'none';
  }
}

// VOX toggle
function toggleVox() {
  alert('VOX Assistant would open here — integrated AI communications layer');
}

// Animate score bars on load
window.addEventListener('load', () => {
  document.querySelectorAll('.score-bar-fill').forEach(bar => {
    const width = bar.style.width;
    bar.style.width = '0%';
    setTimeout(() => { bar.style.width = width; }, 100);
  });
});

// Handle resize
window.addEventListener('resize', () => {
  if (window.innerWidth > 1024) {
    const sidebar = document.getElementById('sidebarDesktop');
    sidebar.style.position = '';
    sidebar.style.left = '';
    sidebar.style.top = '';
    sidebar.style.bottom = '';
    sidebar.style.zIndex = '';
    sidebar.style.display = '';
    sidebar.classList.remove('sidebar-mobile');
    document.getElementById('mobileOverlay').classList.remove('open');
  }
});

// Email functions
function filterEmail(filter) {
  document.querySelectorAll('[id^="email-filter-"]').forEach(btn => {
    btn.classList.remove('bg-[#f0fdfa]', 'text-[#0d9488]');
    btn.classList.add('text-secondary');
  });
  document.getElementById('email-filter-' + filter).classList.add('bg-[#f0fdfa]', 'text-[#0d9488]');
  document.getElementById('email-filter-' + filter).classList.remove('text-secondary');
}

function composeEmail() {
  alert('Compose email modal would open here — integrated with your email provider');
}

// ===== LEAD SCRAPER FUNCTIONS =====
function filterLeads(filter) {
  document.querySelectorAll('[id^="lead-filter-"]').forEach(btn => {
    btn.classList.remove('bg-[#0d9488]', 'text-white');
    btn.classList.add('text-secondary');
  });
  document.getElementById('lead-filter-' + filter).classList.add('bg-[#0d9488]', 'text-white');
  document.getElementById('lead-filter-' + filter).classList.remove('text-secondary');
}

function runSteveQualification() {
  alert('Steve AI is now running full qualification analysis on all 47 pending leads. This will check: business signals, decision-maker access, budget indicators, and competitive positioning. Estimated completion: 3 minutes.');
}

function approveLead(btn) {
  const row = btn.closest('tr');
  const statusCell = row.querySelector('td:nth-child(8)');
  statusCell.innerHTML = '<span class="status-badge bg-[#f0fdfa] text-[#0d9488] border border-[#ccfbf1] text-[10px]">Qualified</span>';
  alert('Lead approved and moved to Qualified pool');
}

function rejectLead(btn) {
  const row = btn.closest('tr');
  const statusCell = row.querySelector('td:nth-child(8)');
  statusCell.innerHTML = '<span class="status-badge bg-red-50 text-red-700 border border-red-100 text-[10px]">Rejected</span>';
  alert('Lead rejected — moved to Rejected pool');
}

function sendToCRM(btn) {
  const row = btn.closest('tr');
  const company = row.querySelector('td:nth-child(2)').textContent.trim().split('
')[0];
  alert(company + ' has been sent to CRM and assigned to sales team');
}

function bulkApprove() {
  alert('All selected leads approved and moved to Qualified pool');
}

function bulkReject() {
  alert('All selected leads rejected and moved to Rejected pool');
}

// ===== POWERDIAL FUNCTIONS =====
let dialNumber = '';
let callTimerInterval = null;
let callSeconds = 0;
let isMuted = false;
let isOnHold = false;

function dialDigit(digit) {
  if (dialNumber.length < 15) {
    dialNumber += digit;
    updateDialDisplay();
  }
}

function clearDial() {
  dialNumber = '';
  updateDialDisplay();
}

function updateDialDisplay() {
  const display = document.getElementById('dialDisplay');
  const nameDisplay = document.getElementById('dialContactName');
  display.value = formatPhoneNumber(dialNumber);

  // Auto-detect contact
  const contacts = {
    '5552345678': 'James Carter — Northstar Roofing',
    '5558765432': 'Amanda Lewis — Prime Dental Group',
    '5553456789': 'Chris Martin — Titan Plumbing',
    '5554567890': 'Sophia Green — Apex Med Spa',
    '5555678901': 'David Kim — Metro Auto Repair'
  };
  const clean = dialNumber.replace(/\D/g, '');
  nameDisplay.textContent = contacts[clean] || '';
}

function formatPhoneNumber(num) {
  const clean = num.replace(/\D/g, '');
  if (clean.length >= 10) {
    return '(' + clean.slice(0, 3) + ') ' + clean.slice(3, 6) + '-' + clean.slice(6, 10);
  }
  return num;
}

function clickToCall(number, name, company) {
  dialNumber = number.replace(/\D/g, '');
  updateDialDisplay();
  makeCall();
}

function makeCall() {
  if (dialNumber.length < 10) {
    alert('Please enter a valid 10-digit phone number');
    return;
  }
  document.getElementById('activeCallPanel').classList.remove('hidden');
  document.getElementById('incomingCallAlert').classList.add('hidden');
  startCallTimer();
}

function answerCall() {
  document.getElementById('incomingCallAlert').classList.add('hidden');
  document.getElementById('activeCallPanel').classList.remove('hidden');
  startCallTimer();
}

function rejectCall() {
  document.getElementById('incomingCallAlert').classList.add('hidden');
  clearDial();
}

function endCall() {
  document.getElementById('activeCallPanel').classList.add('hidden');
  stopCallTimer();
  callSeconds = 0;
  updateTimerDisplay();
  clearDial();
}

function startCallTimer() {
  callSeconds = 0;
  updateTimerDisplay();
  callTimerInterval = setInterval(() => {
    callSeconds++;
    updateTimerDisplay();
  }, 1000);
}

function stopCallTimer() {
  if (callTimerInterval) {
    clearInterval(callTimerInterval);
    callTimerInterval = null;
  }
}

function updateTimerDisplay() {
  const mins = Math.floor(callSeconds / 60).toString().padStart(2, '0');
  const secs = (callSeconds % 60).toString().padStart(2, '0');
  document.getElementById('callTimer').textContent = mins + ':' + secs;
}

function toggleMute() {
  isMuted = !isMuted;
  const btn = document.getElementById('muteBtn');
  if (isMuted) {
    btn.style.background = 'rgba(239, 68, 68, 0.4)';
    btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>';
  } else {
    btn.style.background = 'rgba(255, 255, 255, 0.2)';
    btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>';
  }
}

function toggleHold() {
  isOnHold = !isOnHold;
  const btn = document.getElementById('holdBtn');
  if (isOnHold) {
    btn.style.background = 'rgba(245, 158, 11, 0.4)';
    btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
  } else {
    btn.style.background = 'rgba(255, 255, 255, 0.2)';
    btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
  }
}

function simulateIncoming() {
  document.getElementById('incomingCallAlert').classList.remove('hidden');
  document.getElementById('activeCallPanel').classList.add('hidden');
}

function showDialerTab(tab) {
  document.querySelectorAll('[id^="dialer-panel-"]').forEach(p => p.classList.add('hidden'));
  document.getElementById('dialer-panel-' + tab).classList.remove('hidden');

  document.querySelectorAll('[id^="dialer-tab-"]').forEach(btn => {
    btn.classList.remove('bg-[#0d9488]', 'text-white');
    btn.classList.add('text-secondary');
  });
  document.getElementById('dialer-tab-' + tab).classList.add('bg-[#0d9488]', 'text-white');
  document.getElementById('dialer-tab-' + tab).classList.remove('text-secondary');
}
</script>
</body>
</html>