<div class="vox-bubble" onclick="toggleVox()">
  <div class="vox-avatar avatar-vox flex items-center justify-center text-white font-bold">
    <span class="text-lg">V</span>
    <span class="absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-300 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-400"></span>
    </span>
  </div>
  <div class="text-left hidden sm:block">
    <p class="text-sm font-semibold leading-none">VOX Assistant</p>
    <p class="text-xs text-teal-100 mt-1">Live AI communications active</p>
