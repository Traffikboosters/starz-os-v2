                  <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-9 w-9 rounded-full bg-blue-500 flex items-center justify-center text-white text-xs font-bold">AL</div><div><p class="font-semibold text-primary text-sm">Amanda Lewis</p><p class="text-[11px] text-secondary">Practice Manager</p></div></div></td><td class="px-5 py-4 text-secondary">Prime Dental Group</td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 876-5432</td><td class="px-5 py-4"><span class="status-badge bg-green-50 text-green-700 border border-green-100 text-[10px]">Available</span></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 876-5432', 'Amanda Lewis', 'Prime Dental Group')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
                  <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-9 w-9 rounded-full bg-amber-500 flex items-center justify-center text-white text-xs font-bold">CM</div><div><p class="font-semibold text-primary text-sm">Chris Martin</p><p class="text-[11px] text-secondary">CEO</p></div></div></td><td class="px-5 py-4 text-secondary">Titan Plumbing</td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 345-6789</td><td class="px-5 py-4"><span class="status-badge bg-amber-50 text-amber-700 border border-amber-100 text-[10px]">Busy</span></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 345-6789', 'Chris Martin', 'Titan Plumbing')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
                  <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-9 w-9 rounded-full bg-pink-500 flex items-center justify-center text-white text-xs font-bold">SG</div><div><p class="font-semibold text-primary text-sm">Sophia Green</p><p class="text-[11px] text-secondary">Director</p></div></div></td><td class="px-5 py-4 text-secondary">Apex Med Spa</td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 456-7890</td><td class="px-5 py-4"><span class="status-badge bg-green-50 text-green-700 border border-green-100 text-[10px]">Available</span></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 456-7890', 'Sophia Green', 'Apex Med Spa')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
                  <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-9 w-9 rounded-full bg-purple-500 flex items-center justify-center text-white text-xs font-bold">DK</div><div><p class="font-semibold text-primary text-sm">David Kim</p><p class="text-[11px] text-secondary">Owner</p></div></div></td><td class="px-5 py-4 text-secondary">Metro Auto Repair</td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 567-8901</td><td class="px-5 py-4"><span class="status-badge bg-green-50 text-green-700 border border-green-100 text-[10px]">Available</span></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 567-8901', 'David Kim', 'Metro Auto Repair')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
