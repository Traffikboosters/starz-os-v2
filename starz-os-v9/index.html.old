        </section>
      </div>
    </div>

    
        <!-- ===== POWERDIAL WORKSPACE ===== -->
    <div id="workspace-powerdial" class="workspace-view">
      <div class="mb-5 lg:mb-6">
        <h2 class="text-xl lg:text-2xl font-bold text-primary mb-2">PowerDial</h2>
        <p class="text-sm text-secondary">Call Smarter · Connect Faster · Close More — Manual & Auto Dialing</p>
      </div>

      <!-- INCOMING CALL ALERT (hidden by default) -->
      <div id="incomingCallAlert" class="hidden mb-5 lg:mb-6 surface-elevated rounded-2xl p-5 border-2 border-green-400" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="relative">
              <div class="w-14 h-14 rounded-full bg-green-500 flex items-center justify-center text-white font-bold text-xl animate-pulse">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <span class="absolute -top-1 -right-1 flex h-4 w-4"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span><span class="relative inline-flex rounded-full h-4 w-4 bg-green-500"></span></span>
            </div>
            <div>
              <p class="text-sm text-green-700 font-semibold">INCOMING CALL</p>
              <h3 class="text-xl font-bold text-primary">Apex Med Spa</h3>
              <p class="text-sm text-secondary">Sophia Green · (555) 456-7890</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="rejectCall()" class="px-5 py-3 rounded-xl bg-red-500 hover:bg-red-600 text-white font-semibold text-sm transition-colors flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/></svg>
              Decline
            </button>
            <button onclick="answerCall()" class="px-5 py-3 rounded-xl bg-green-500 hover:bg-green-600 text-white font-semibold text-sm transition-colors flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Answer
            </button>
          </div>
        </div>
      </div>

      <!-- ACTIVE CALL PANEL (hidden by default) -->
      <div id="activeCallPanel" class="hidden mb-5 lg:mb-6 surface-elevated rounded-2xl p-6" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center text-white font-bold text-2xl backdrop-blur-sm">
              SG
            </div>
            <div>
              <p class="text-sm text-teal-100 font-medium">ON CALL</p>
              <h3 class="text-2xl font-bold text-white">Sophia Green</h3>
              <p class="text-sm text-teal-100">Apex Med Spa · (555) 456-7890</p>
            </div>
          </div>
          <div class="text-center">
            <div id="callTimer" class="text-3xl font-bold text-white font-mono">00:00</div>
            <p class="text-xs text-teal-100 mt-1">Call Duration</p>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="toggleMute()" id="muteBtn" class="w-12 h-12 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition-colors backdrop-blur-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
            </button>
            <button onclick="toggleHold()" id="holdBtn" class="w-12 h-12 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition-colors backdrop-blur-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </button>
            <button onclick="endCall()" class="w-14 h-14 rounded-full bg-red-500 hover:bg-red-600 text-white flex items-center justify-center transition-colors shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-5">
        <!-- DIAL PAD -->
        <section class="lg:col-span-4 space-y-4">
          <div class="surface-elevated rounded-2xl p-5">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl avatar-powerdial flex items-center justify-center text-white font-bold text-lg">P</div>
              <div class="flex items-center gap-2"><span class="live-dot" style="width:6px;height:6px;"></span><span class="text-xs text-secondary font-medium">24 Lines Ready</span></div>
            </div>

            <!-- Number Display -->
            <div class="bg-[var(--bg-primary)] rounded-xl p-4 mb-4 border border-[var(--border-color)]">
              <input type="text" id="dialDisplay" readonly class="w-full bg-transparent text-2xl font-bold text-primary text-center outline-none" placeholder="Enter number">
              <p id="dialContactName" class="text-xs text-secondary text-center mt-1 h-4"></p>
            </div>

            <!-- Dial Pad -->
            <div class="grid grid-cols-3 gap-2 mb-4">
              <button onclick="dialDigit('1')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>1</span><span class="text-[10px] text-secondary font-normal">&nbsp;</span></button>
              <button onclick="dialDigit('2')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>2</span><span class="text-[10px] text-secondary font-normal">ABC</span></button>
              <button onclick="dialDigit('3')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>3</span><span class="text-[10px] text-secondary font-normal">DEF</span></button>
              <button onclick="dialDigit('4')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>4</span><span class="text-[10px] text-secondary font-normal">GHI</span></button>
              <button onclick="dialDigit('5')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>5</span><span class="text-[10px] text-secondary font-normal">JKL</span></button>
              <button onclick="dialDigit('6')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>6</span><span class="text-[10px] text-secondary font-normal">MNO</span></button>
              <button onclick="dialDigit('7')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>7</span><span class="text-[10px] text-secondary font-normal">PQRS</span></button>
              <button onclick="dialDigit('8')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>8</span><span class="text-[10px] text-secondary font-normal">TUV</span></button>
              <button onclick="dialDigit('9')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>9</span><span class="text-[10px] text-secondary font-normal">WXYZ</span></button>
              <button onclick="dialDigit('*')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex items-center justify-center">*</button>
              <button onclick="dialDigit('0')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>0</span><span class="text-[10px] text-secondary font-normal">+</span></button>
              <button onclick="dialDigit('#')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex items-center justify-center">#</button>
            </div>

            <!-- Call Actions -->
