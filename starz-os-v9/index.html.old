        <h2 class="text-xl lg:text-2xl font-bold text-primary mb-2">CRM Workspace</h2>
        <p class="text-sm text-secondary">Customer relationship management — contacts, companies, interactions</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 lg:gap-5 mb-5 lg:mb-6">
        <div class="surface-elevated rounded-2xl p-5">
          <p class="text-[11px] text-secondary uppercase tracking-wider font-semibold mb-2">Total Contacts</p>
          <h3 class="text-3xl font-bold text-primary mb-1">1,248</h3>
          <p class="text-xs text-secondary">+42 this week</p>
        </div>
        <div class="surface-elevated rounded-2xl p-5">
          <p class="text-[11px] text-secondary uppercase tracking-wider font-semibold mb-2">Companies</p>
          <h3 class="text-3xl font-bold text-primary mb-1">386</h3>
          <p class="text-xs text-secondary">Active accounts</p>
        </div>
        <div class="surface-elevated rounded-2xl p-5">
          <p class="text-[11px] text-secondary uppercase tracking-wider font-semibold mb-2">Interactions</p>
          <h3 class="text-3xl font-bold text-primary mb-1">2,847</h3>
          <p class="text-xs text-secondary">Calls, emails, meetings</p>
        </div>
        <div class="surface-elevated rounded-2xl p-5">
          <p class="text-[11px] text-secondary uppercase tracking-wider font-semibold mb-2">Conversion</p>
          <h3 class="text-3xl font-bold text-primary mb-1">34%</h3>
          <p class="text-xs text-secondary">Lead to opportunity</p>
        </div>
      </div>
      <div class="surface-elevated rounded-2xl overflow-hidden">
        <div class="px-5 py-4 border-b border-[var(--border-color)] flex items-center justify-between flex-wrap gap-2">
          <div><h3 class="font-semibold text-primary">All Contacts</h3><p class="text-[11px] text-secondary mt-0.5">Manage leads, prospects, and customers</p></div>
          <button class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">Add Contact</button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm data-table">
            <thead><tr style="background: var(--bg-primary);"><th class="text-left px-5 py-3">Name</th><th class="text-left px-5 py-3">Company</th><th class="text-left px-5 py-3">Title</th><th class="text-left px-5 py-3">Source</th><th class="text-left px-5 py-3">Status</th><th class="text-left px-5 py-3">Last Contact</th><th class="text-left px-5 py-3">Actions</th></tr></thead>
            <tbody>
              <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-8 w-8 rounded-full bg-[#0d9488] flex items-center justify-center text-white text-xs font-bold">JC</div><div><p class="font-semibold text-primary text-sm">James Carter</p><p class="text-[11px] text-secondary">james@northstar.com</p></div></div></td><td class="px-5 py-4 text-secondary">Northstar Roofing</td><td class="px-5 py-4 text-secondary">Owner</td><td class="px-5 py-4 text-secondary">LinkedIn</td><td class="px-5 py-4"><span class="status-badge bg-[#f0fdfa] text-[#0d9488] border border-[#ccfbf1] text-[10px]">Lead</span></td><td class="px-5 py-4 text-secondary">2 days ago</td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">View</button></td></tr>
              <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-xs font-bold">AL</div><div><p class="font-semibold text-primary text-sm">Amanda Lewis</p><p class="text-[11px] text-secondary">amanda@primedental.com</p></div></div></td><td class="px-5 py-4 text-secondary">Prime Dental Group</td><td class="px-5 py-4 text-secondary">Practice Manager</td><td class="px-5 py-4 text-secondary">Google Maps</td><td class="px-5 py-4"><span class="status-badge bg-blue-50 text-blue-700 border border-blue-100 text-[10px]">Opportunity</span></td><td class="px-5 py-4 text-secondary">Yesterday</td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">View</button></td></tr>
              <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-8 w-8 rounded-full bg-amber-500 flex items-center justify-center text-white text-xs font-bold">CM</div><div><p class="font-semibold text-primary text-sm">Chris Martin</p><p class="text-[11px] text-secondary">chris@titanplumb.com</p></div></div></td><td class="px-5 py-4 text-secondary">Titan Plumbing</td><td class="px-5 py-4 text-secondary">CEO</td><td class="px-5 py-4 text-secondary">Craigslist</td><td class="px-5 py-4"><span class="status-badge bg-amber-50 text-amber-700 border border-amber-100 text-[10px]">Follow Up</span></td><td class="px-5 py-4 text-secondary">3 days ago</td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">View</button></td></tr>
              <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-8 w-8 rounded-full bg-pink-500 flex items-center justify-center text-white text-xs font-bold">SG</div><div><p class="font-semibold text-primary text-sm">Sophia Green</p><p class="text-[11px] text-secondary">sophia@apexmedspa.com</p></div></div></td><td class="px-5 py-4 text-secondary">Apex Med Spa</td><td class="px-5 py-4 text-secondary">Director</td><td class="px-5 py-4 text-secondary">411</td><td class="px-5 py-4"><span class="status-badge bg-red-50 text-red-700 border border-red-100 text-[10px] animate-pulse">Hot Lead</span></td><td class="px-5 py-4 text-secondary">Just now</td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">View</button></td></tr>
              <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><div class="h-8 w-8 rounded-full bg-purple-500 flex items-center justify-center text-white text-xs font-bold">DK</div><div><p class="font-semibold text-primary text-sm">David Kim</p><p class="text-[11px] text-secondary">david@metroauto.com</p></div></div></td><td class="px-5 py-4 text-secondary">Metro Auto Repair</td><td class="px-5 py-4 text-secondary">Owner</td><td class="px-5 py-4 text-secondary">Referral</td><td class="px-5 py-4"><span class="status-badge bg-[#f0fdfa] text-[#0d9488] border border-[#ccfbf1] text-[10px]">New</span></td><td class="px-5 py-4 text-secondary">Today</td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">View</button></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ===== POWERDIAL WORKSPACE ===== -->
    <div id="workspace-powerdial" class="workspace-view">
      <div class="mb-5 lg:mb-6">
        <h2 class="text-xl lg:text-2xl font-bold text-primary mb-2">PowerDial</h2>
        <p class="text-sm text-secondary">Call Smarter · Connect Faster · Close More — Manual & Auto Dialing</p>
      </div>

      <!-- INCOMING CALL ALERT (hidden by default) -->
      <div id="incomingCallAlert" class="hidden mb-5 lg:mb-6 surface-elevated rounded-2xl p-5 border-2 border-green-400" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="relative">
              <div class="w-14 h-14 rounded-full bg-green-500 flex items-center justify-center text-white font-bold text-xl animate-pulse">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <span class="absolute -top-1 -right-1 flex h-4 w-4"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span><span class="relative inline-flex rounded-full h-4 w-4 bg-green-500"></span></span>
            </div>
            <div>
              <p class="text-sm text-green-700 font-semibold">INCOMING CALL</p>
              <h3 class="text-xl font-bold text-primary">Apex Med Spa</h3>
              <p class="text-sm text-secondary">Sophia Green · (555) 456-7890</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="rejectCall()" class="px-5 py-3 rounded-xl bg-red-500 hover:bg-red-600 text-white font-semibold text-sm transition-colors flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/></svg>
              Decline
            </button>
            <button onclick="answerCall()" class="px-5 py-3 rounded-xl bg-green-500 hover:bg-green-600 text-white font-semibold text-sm transition-colors flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Answer
            </button>
          </div>
        </div>
      </div>

      <!-- ACTIVE CALL PANEL (hidden by default) -->
      <div id="activeCallPanel" class="hidden mb-5 lg:mb-6 surface-elevated rounded-2xl p-6" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center text-white font-bold text-2xl backdrop-blur-sm">
              SG
            </div>
            <div>
              <p class="text-sm text-teal-100 font-medium">ON CALL</p>
              <h3 class="text-2xl font-bold text-white">Sophia Green</h3>
              <p class="text-sm text-teal-100">Apex Med Spa · (555) 456-7890</p>
            </div>
          </div>
          <div class="text-center">
            <div id="callTimer" class="text-3xl font-bold text-white font-mono">00:00</div>
            <p class="text-xs text-teal-100 mt-1">Call Duration</p>
          </div>
          <div class="flex items-center gap-3">
            <button onclick="toggleMute()" id="muteBtn" class="w-12 h-12 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition-colors backdrop-blur-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
            </button>
            <button onclick="toggleHold()" id="holdBtn" class="w-12 h-12 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition-colors backdrop-blur-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </button>
            <button onclick="endCall()" class="w-14 h-14 rounded-full bg-red-500 hover:bg-red-600 text-white flex items-center justify-center transition-colors shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M5 3a2 2 0 00-2 2v1c0 8.284 6.716 15 15 15h1a2 2 0 002-2v-3.28a1 1 0 00-.684-.948l-4.493-1.498a1 1 0 00-1.21.502l-1.13 2.257a11.042 11.042 0 01-5.516-5.517l2.257-1.128a1 1 0 00.502-1.21L9.228 3.683A1 1 0 008.279 3H5z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-5">
        <!-- DIAL PAD -->
        <section class="lg:col-span-4 space-y-4">
          <div class="surface-elevated rounded-2xl p-5">
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl avatar-powerdial flex items-center justify-center text-white font-bold text-lg">P</div>
              <div class="flex items-center gap-2"><span class="live-dot" style="width:6px;height:6px;"></span><span class="text-xs text-secondary font-medium">24 Lines Ready</span></div>
            </div>

            <!-- Number Display -->
            <div class="bg-[var(--bg-primary)] rounded-xl p-4 mb-4 border border-[var(--border-color)]">
              <input type="text" id="dialDisplay" readonly class="w-full bg-transparent text-2xl font-bold text-primary text-center outline-none" placeholder="Enter number">
              <p id="dialContactName" class="text-xs text-secondary text-center mt-1 h-4"></p>
            </div>

            <!-- Dial Pad -->
            <div class="grid grid-cols-3 gap-2 mb-4">
              <button onclick="dialDigit('1')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>1</span><span class="text-[10px] text-secondary font-normal">&nbsp;</span></button>
              <button onclick="dialDigit('2')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>2</span><span class="text-[10px] text-secondary font-normal">ABC</span></button>
              <button onclick="dialDigit('3')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>3</span><span class="text-[10px] text-secondary font-normal">DEF</span></button>
              <button onclick="dialDigit('4')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>4</span><span class="text-[10px] text-secondary font-normal">GHI</span></button>
              <button onclick="dialDigit('5')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>5</span><span class="text-[10px] text-secondary font-normal">JKL</span></button>
              <button onclick="dialDigit('6')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>6</span><span class="text-[10px] text-secondary font-normal">MNO</span></button>
              <button onclick="dialDigit('7')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>7</span><span class="text-[10px] text-secondary font-normal">PQRS</span></button>
              <button onclick="dialDigit('8')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>8</span><span class="text-[10px] text-secondary font-normal">TUV</span></button>
              <button onclick="dialDigit('9')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>9</span><span class="text-[10px] text-secondary font-normal">WXYZ</span></button>
              <button onclick="dialDigit('*')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex items-center justify-center">*</button>
              <button onclick="dialDigit('0')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex flex-col items-center justify-center"><span>0</span><span class="text-[10px] text-secondary font-normal">+</span></button>
              <button onclick="dialDigit('#')" class="aspect-square rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-lg font-semibold text-primary transition-colors flex items-center justify-center">#</button>
            </div>

            <!-- Call Actions -->
            <div class="grid grid-cols-3 gap-2">
              <button onclick="clearDial()" class="py-3 rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-secondary transition-colors flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z"/></svg>
              </button>
              <button onclick="makeCall()" class="py-3 rounded-xl bg-green-500 hover:bg-green-600 text-white font-semibold transition-colors flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call
              </button>
              <button onclick="clearDial()" class="py-3 rounded-xl bg-[var(--bg-primary)] hover:bg-[var(--nav-hover)] border border-[var(--border-color)] text-secondary transition-colors flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </div>

          <!-- Quick Stats -->
          <div class="surface-elevated rounded-2xl p-5">
            <p class="text-[11px] text-secondary uppercase tracking-wider font-semibold mb-3">Session Stats</p>
            <div class="space-y-3">
              <div class="flex justify-between text-sm"><span class="text-secondary">Calls Made</span><span class="font-semibold text-primary">247</span></div>
              <div class="flex justify-between text-sm"><span class="text-secondary">Connected</span><span class="font-semibold text-primary">84</span></div>
              <div class="flex justify-between text-sm"><span class="text-secondary">Connect Rate</span><span class="font-semibold text-primary">34.2%</span></div>
              <div class="flex justify-between text-sm"><span class="text-secondary">Talk Time</span><span class="font-semibold text-primary">4h 23m</span></div>
              <div class="flex justify-between text-sm"><span class="text-secondary">Appointments</span><span class="font-semibold text-primary">12</span></div>
            </div>
          </div>
        </section>

        <!-- CONTACTS & QUEUE -->
        <section class="lg:col-span-8 space-y-4">
          <!-- Tabs -->
          <div class="flex gap-2 p-1 rounded-xl" style="background: var(--bg-primary);">
            <button onclick="showDialerTab('contacts')" id="dialer-tab-contacts" class="flex-1 py-2 px-4 rounded-lg text-sm font-medium bg-[#0d9488] text-white transition-colors">Contacts</button>
            <button onclick="showDialerTab('queue')" id="dialer-tab-queue" class="flex-1 py-2 px-4 rounded-lg text-sm font-medium text-secondary hover:bg-[var(--nav-hover)] transition-colors">Call Queue (156)</button>
            <button onclick="showDialerTab('history')" id="dialer-tab-history" class="flex-1 py-2 px-4 rounded-lg text-sm font-medium text-secondary hover:bg-[var(--nav-hover)] transition-colors">History</button>
          </div>

          <!-- Contacts Tab -->
          <div id="dialer-panel-contacts" class="surface-elevated rounded-2xl overflow-hidden">
            <div class="px-5 py-4 border-b border-[var(--border-color)] flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-3">
                <input type="text" placeholder="Search contacts..." class="px-3 py-2 rounded-lg border border-[var(--border-color)] text-sm text-primary outline-none focus:border-[#0d9488] transition-colors" style="background: var(--bg-primary); width: 240px;">
              </div>
              <div class="flex items-center gap-2">
                <button onclick="simulateIncoming()" class="px-3 py-2 rounded-lg bg-green-50 text-green-700 border border-green-100 text-xs font-semibold hover:bg-green-100 transition-colors">Simulate Incoming</button>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm data-table">
                <thead><tr style="background: var(--bg-primary);"><th class="text-left px-5 py-3">Contact</th><th class="text-left px-5 py-3">Company</th><th class="text-left px-5 py-3">Number</th><th class="text-left px-5 py-3">Status</th><th class="text-left px-5 py-3">Actions</th></tr></thead>
                <tbody>
