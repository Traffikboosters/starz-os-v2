                <tbody>
                  <tr><td class="px-5 py-4"><span class="status-badge bg-red-50 text-red-700 border border-red-100 text-[10px]">High</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 111-2222</td><td class="px-5 py-4 font-semibold text-primary">Elite Landscaping</td><td class="px-5 py-4 text-secondary">Referral</td><td class="px-5 py-4"><div class="flex items-center gap-2"><div class="score-bar-bg w-16"><div class="score-bar-fill" style="width:96%"></div></div><span class="font-semibold text-primary text-sm">96</span></div></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 111-2222', 'Elite Landscaping', 'Unknown')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
                  <tr><td class="px-5 py-4"><span class="status-badge bg-red-50 text-red-700 border border-red-100 text-[10px]">High</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 222-3333</td><td class="px-5 py-4 font-semibold text-primary">Sunrise Dental</td><td class="px-5 py-4 text-secondary">Google Ads</td><td class="px-5 py-4"><div class="flex items-center gap-2"><div class="score-bar-bg w-16"><div class="score-bar-fill" style="width:91%"></div></div><span class="font-semibold text-primary text-sm">91</span></div></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 222-3333', 'Sunrise Dental', 'Unknown')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
                  <tr><td class="px-5 py-4"><span class="status-badge bg-amber-50 text-amber-700 border border-amber-100 text-[10px]">Medium</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 333-4444</td><td class="px-5 py-4 font-semibold text-primary">Citywide HVAC</td><td class="px-5 py-4 text-secondary">Craigslist</td><td class="px-5 py-4"><div class="flex items-center gap-2"><div class="score-bar-bg w-16"><div class="score-bar-fill" style="width:84%"></div></div><span class="font-semibold text-primary text-sm">84</span></div></td><td class="px-5 py-4"><button onclick="clickToCall('(555) 333-4444', 'Citywide HVAC', 'Unknown')" class="bg-[#0d9488] hover:bg-[#0f766e] text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Call</button></td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- History Tab (hidden) -->
          <div id="dialer-panel-history" class="hidden surface-elevated rounded-2xl overflow-hidden">
            <div class="px-5 py-4 border-b border-[var(--border-color)]"><h3 class="font-semibold text-primary">Call History</h3><p class="text-[11px] text-secondary mt-0.5">Recent calls and outcomes</p></div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm data-table">
                <thead><tr style="background: var(--bg-primary);"><th class="text-left px-5 py-3">Time</th><th class="text-left px-5 py-3">Direction</th><th class="text-left px-5 py-3">Number</th><th class="text-left px-5 py-3">Company</th><th class="text-left px-5 py-3">Duration</th><th class="text-left px-5 py-3">Outcome</th><th class="text-left px-5 py-3">Recording</th></tr></thead>
                <tbody>
                  <tr><td class="px-5 py-4 text-secondary">2:34 PM</td><td class="px-5 py-4"><span class="status-badge bg-blue-50 text-blue-700 border border-blue-100 text-[10px]">Outbound</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 234-5678</td><td class="px-5 py-4 font-semibold text-primary">Northstar Roofing</td><td class="px-5 py-4 text-secondary">4:23</td><td class="px-5 py-4"><span class="status-badge bg-green-50 text-green-700 border border-green-100 text-[10px]">Connected</span></td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">Play</button></td></tr>
                  <tr><td class="px-5 py-4 text-secondary">2:28 PM</td><td class="px-5 py-4"><span class="status-badge bg-blue-50 text-blue-700 border border-blue-100 text-[10px]">Outbound</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 876-5432</td><td class="px-5 py-4 font-semibold text-primary">Prime Dental Group</td><td class="px-5 py-4 text-secondary">0:32</td><td class="px-5 py-4"><span class="status-badge bg-amber-50 text-amber-700 border border-amber-100 text-[10px]">Voicemail</span></td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">Play</button></td></tr>
                  <tr><td class="px-5 py-4 text-secondary">1:45 PM</td><td class="px-5 py-4"><span class="status-badge bg-purple-50 text-purple-700 border border-purple-100 text-[10px]">Inbound</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 456-7890</td><td class="px-5 py-4 font-semibold text-primary">Apex Med Spa</td><td class="px-5 py-4 text-secondary">6:12</td><td class="px-5 py-4"><span class="status-badge bg-green-50 text-green-700 border border-green-100 text-[10px]">Connected</span></td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">Play</button></td></tr>
                  <tr><td class="px-5 py-4 text-secondary">11:20 AM</td><td class="px-5 py-4"><span class="status-badge bg-blue-50 text-blue-700 border border-blue-100 text-[10px]">Outbound</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 345-6789</td><td class="px-5 py-4 font-semibold text-primary">Titan Plumbing</td><td class="px-5 py-4 text-secondary">2:15</td><td class="px-5 py-4"><span class="status-badge bg-green-50 text-green-700 border border-green-100 text-[10px]">Connected</span></td><td class="px-5 py-4"><button class="text-[#0d9488] hover:underline text-sm font-medium">Play</button></td></tr>
                  <tr><td class="px-5 py-4 text-secondary">10:05 AM</td><td class="px-5 py-4"><span class="status-badge bg-blue-50 text-blue-700 border border-blue-100 text-[10px]">Outbound</span></td><td class="px-5 py-4 font-mono text-xs text-secondary">(555) 456-7890</td><td class="px-5 py-4 font-semibold text-primary">Apex Med Spa</td><td class="px-5 py-4 text-secondary">0:00</td><td class="px-5 py-4"><span class="status-badge bg-red-50 text-red-700 border border-red-100 text-[10px]">No Answer</span></td><td class="px-5 py-4"><span class="text-muted text-sm">—</span></td></tr>
                </tbody>
              </table>
            </div>
